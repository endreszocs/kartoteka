# ─────────────────────────────────────────────────────────────
# ADR seed — hivatalos romániai cím-hierarchia nyers adatai
# (~200 MB, a scriptem generálja belőle a SQL-eket)
# ─────────────────────────────────────────────────────────────
migration-docs/data/adr-seed/*.zip
migration-docs/data/adr-seed/*.xls
migration-docs/data/adr-seed/_unpacked/

# ─────────────────────────────────────────────────────────────
# Tauri desktop — build output-ok + signing artifactok (M3+)
# A cargo build `C:\kartoteka-target`-be ment (.cargo/config.toml miatt),
# de ha lokális target/ valamiért létrejön, ne commitoljuk.
# ─────────────────────────────────────────────────────────────
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/schemas/

# Code-signing certificates — saját-privát kulcsok, NE kerüljenek a repóba
ops/*.pfx
ops/*.p12
ops/*.key
ops/*.pem
*.pfx

# Desktop telepítő-binárisok — a /downloads route a Railway-en szolgálja őket,
# de a repo-ban ne legyenek (15-30 MB-os fájlok). Minden .exe / .msi a
# public/downloads/-ból ki van zárva, kivéve a README-t és a version.txt-t.
apps/web/public/downloads/*.exe
apps/web/public/downloads/*.msi
apps/web/public/downloads/*.dmg
apps/web/public/downloads/*.AppImage
apps/web/public/downloads/*.deb
apps/web/public/downloads/*.rpm

# ─────────────────────────────────────────────────────────────
# Secrets — soha NE kerüljenek a repóba (l. DIAGNOSTICS P0-1, P0-2)
# ─────────────────────────────────────────────────────────────
migration-docs/BREVO-SMTP.txt
migration-docs/**/*SMTP*
migration-docs/**/*SECRET*
migration-docs/google.cloud.console/

# ─────────────────────────────────────────────────────────────
# Helyi kísérleti / handoff / splash munkamappák — git status szennyezés
# ─────────────────────────────────────────────────────────────
.tmp-*/
.tmp-*.tar
.tmp-*.html
.tmp-*.unzipped
.codex-node_modules
.claude/
