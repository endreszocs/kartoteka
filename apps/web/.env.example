# ═══════════════════════════════════════════════════════════════════
# SUPABASE (kötelező)
# ═══════════════════════════════════════════════════════════════════

# A Supabase projekt publikus URL-je és anon kulcsa — kliens-oldalon is használva
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# CSAK SZERVER-OLDALON használatos — SOHA ne kerüljön a böngésző bundle-be!
# Ez a service_role kulcs megkerüli az összes RLS policy-t, tehát teljes
# adatbázis-hozzáférést ad. Csak a god mode PIN kezeléshez, delegált
# importhoz, és a missziós műhely gamifikációs írásokhoz használjuk.
SUPABASE_SERVICE_ROLE_KEY=


# ═══════════════════════════════════════════════════════════════════
# MASTER ADMIN (kötelező god mode és rendszerszintű műveletekhez)
# ═══════════════════════════════════════════════════════════════════

# A master admin email címe — ezzel bejelentkezve kap god mode jogot.
# Pontosan egy email cím, case-insensitive összehasonlítással.
MASTER_ADMIN_EMAIL=

# A god mode aktiváláshoz szükséges 6 számjegyes PIN.
# FONTOS: ha ez nincs beállítva ÉS a system_settings táblában sincs,
# a god mode nem aktiválható. A kódban NINCS default PIN!
GOD_MODE_PIN=


# ═══════════════════════════════════════════════════════════════════
# AI ASSZISZTENS (Aladár) — opcionális, legalább egy elég
# ═══════════════════════════════════════════════════════════════════

OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=


# ═══════════════════════════════════════════════════════════════════
# PUBLIKUS OLDAL — opcionális
# ═══════════════════════════════════════════════════════════════════

# A publikus oldal teljes URL-je (sitemap-hez, opengraph-hez, email linkekhez).
# Példa: https://kartoteka.example.com
NEXT_PUBLIC_APP_URL=


# ═══════════════════════════════════════════════════════════════════
# TAGI PORTÁL — csak az adatbázis-migrációk és Auth-hook tesztje után
# ═══════════════════════════════════════════════════════════════════

# Fail-closed kapcsoló. Alapértelmezésben maradjon false/üres; true esetén
# csak a külön SCHEMA_READY kapuval együtt jelenik meg a tagi belépés.
MEMBER_PORTAL_AUTH_ENABLED=false

# Csak a teljes Supabase migráció, Auth-hook és háromszereplős RLS-próba után
# állítható true-ra. A két kapcsoló közül bármelyik false/hiányzó értéke zárva tart.
MEMBER_PORTAL_SCHEMA_READY=false

# A Railway cron és a belső worker-végpont közös, legalább 32 karakteres titka.
# Ne használd más célra, és ne tedd NEXT_PUBLIC_ változóba.
NEWSLETTER_WORKER_SECRET=

# A külön Railway cron service által hívott teljes HTTPS URL.
# Példa: https://kartoteka.example.com/api/internal/member-newsletters
NEWSLETTER_WORKER_ENDPOINT=

# Opcionális korlátok; az alapértékek kis, biztonságos adagokra vannak hangolva.
NEWSLETTER_WORKER_BATCH_SIZE=10
NEWSLETTER_WORKER_LEASE_SECONDS=900
NEWSLETTER_WORKER_MAX_ATTEMPTS=4
NEWSLETTER_WORKER_RETRY_BASE_SECONDS=300


# ═══════════════════════════════════════════════════════════════════
# EMAIL (M0.2 — access-request + broadcast)
# ═══════════════════════════════════════════════════════════════════

# Email-provider választás — alapértelmezett: brevo
# Lehetséges: brevo (EU, GDPR, ajánlott) | resend (USA, legacy)
EMAIL_PROVIDER=brevo

# Brevo (ex-SendinBlue) — francia EU, ingyenes 300/nap
# API key: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
# Feladó email (a Brevo-ban verifikált)
BREVO_FROM_EMAIL=no-reply@kartoteka.ro
# Feladó megjelenő név
BREVO_FROM_NAME=Kartotéka Rendszer

# Resend (legacy, opcionális — ha EMAIL_PROVIDER=resend)
RESEND_API_KEY=
RESEND_FROM="Kartotéka <noreply@kartoteka.ro>"


# ═══════════════════════════════════════════════════════════════════
# IP-HASH (M0.2 — spam-védelem, GDPR-kompatibilis)
# ═══════════════════════════════════════════════════════════════════

# SHA-256 só az IP-címhez. Random 32+ karakter ajánlott.
# Generálás: openssl rand -hex 32
IP_HASH_SALT=
