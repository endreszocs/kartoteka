# ═══════════════════════════════════════════════════════════════════
# SUPABASE (kötelező)
# ═══════════════════════════════════════════════════════════════════

# A Supabase projekt publikus URL-je és anon kulcsa — kliens-oldalon is használva
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# CSAK SZERVER-OLDALON használatos — SOHA ne kerüljön a böngésző bundle-be!
# Ez a service_role kulcs megkerüli az összes RLS policy-t, tehát teljes
# adatbázis-hozzáférést ad. Csak a god mode PIN kezeléshez, delegált
# importhoz, és a missziós műhely gamifikációs írásokhoz használjuk.
SUPABASE_SERVICE_ROLE_KEY=


# ═══════════════════════════════════════════════════════════════════
# MASTER ADMIN (kötelező god mode és rendszerszintű műveletekhez)
# ═══════════════════════════════════════════════════════════════════

# A master admin email címe — ezzel bejelentkezve kap god mode jogot.
# Pontosan egy email cím, case-insensitive összehasonlítással.
MASTER_ADMIN_EMAIL=

# A god mode aktiváláshoz szükséges 6 számjegyes PIN.
# FONTOS: ha ez nincs beállítva ÉS a system_settings táblában sincs,
# a god mode nem aktiválható. A kódban NINCS default PIN!
GOD_MODE_PIN=


# ═══════════════════════════════════════════════════════════════════
# PUBLIKUS OLDAL — opcionális
# ═══════════════════════════════════════════════════════════════════

# A publikus oldal teljes URL-je (sitemap-hez, opengraph-hez, email linkekhez).
# Példa: https://kartoteka.example.com
NEXT_PUBLIC_APP_URL=


# ═══════════════════════════════════════════════════════════════════
# TAGI PORTÁL — csak az adatbázis-migrációk és Auth-hook tesztje után
# ═══════════════════════════════════════════════════════════════════

# Fail-closed kapcsoló. Alapértelmezésben maradjon false/üres; true esetén
# csak a külön SCHEMA_READY kapuval együtt jelenik meg a tagi belépés.
MEMBER_PORTAL_AUTH_ENABLED=false

# Csak a teljes Supabase migráció, Auth-hook és háromszereplős RLS-próba után
# állítható true-ra. A két kapcsoló közül bármelyik false/hiányzó értéke zárva tart.
MEMBER_PORTAL_SCHEMA_READY=false

# A Railway cron és a belső worker-végpont közös, legalább 32 karakteres titka.
# Ne használd más célra, és ne tedd NEXT_PUBLIC_ változóba.
NEWSLETTER_WORKER_SECRET=

# A külön Railway cron service által hívott teljes HTTPS URL.
# Példa: https://kartoteka.example.com/api/internal/member-newsletters
NEWSLETTER_WORKER_ENDPOINT=

# Opcionális korlátok; az alapértékek kis, biztonságos adagokra vannak hangolva.
NEWSLETTER_WORKER_BATCH_SIZE=10
NEWSLETTER_WORKER_LEASE_SECONDS=900
NEWSLETTER_WORKER_MAX_ATTEMPTS=4
NEWSLETTER_WORKER_RETRY_BASE_SECONDS=300


# ═══════════════════════════════════════════════════════════════════
# EMAIL (M0.2 — access-request + broadcast)
# ═══════════════════════════════════════════════════════════════════

# Email-provider választás — alapértelmezett: brevo
# Lehetséges: brevo (EU, GDPR, ajánlott) | resend (USA, legacy)
EMAIL_PROVIDER=brevo

# Brevo (ex-SendinBlue) — francia EU, ingyenes 300/nap
# API key: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
# Feladó email (a Brevo-ban verifikált)
BREVO_FROM_EMAIL=no-reply@kartoteka.ro
# Feladó megjelenő név
BREVO_FROM_NAME=Kartotéka Rendszer

# Resend (legacy, opcionális — ha EMAIL_PROVIDER=resend)
RESEND_API_KEY=
RESEND_FROM="Kartotéka <noreply@kartoteka.ro>"


# ═══════════════════════════════════════════════════════════════════
# IP-HASH (M0.2 — spam-védelem, GDPR-kompatibilis)
# ═══════════════════════════════════════════════════════════════════

# SHA-256 só az IP-címhez. Random 32+ karakter ajánlott.
# Generálás: openssl rand -hex 32
IP_HASH_SALT=


# ═══════════════════════════════════════════════════════════════════
# BIZTONSÁGI MENTÉS — a motor változói (2026-08-11)
# ═══════════════════════════════════════════════════════════════════
# HÁROM KÜLÖN TITOK, SOHA NE LEGYEN UGYANAZ:
#   BACKUP_ENCRYPTION_KEY  — az ADAT titkosítása
#   BACKUP_WORKER_SECRET   — KI INDÍTHAT mentést (olvasni NEM tud)
#   Google refresh token   — NEM env változó: titkosítva a backup_settings-ben
#
# ⛔ A BACKUP_ENCRYPTION_KEY-nek NINCS fallbackja. Ha hiányzik vagy nem
#    pontosan 32 bájt, a mentés HANGOS hibával leáll (503) — inkább ne
#    legyen mentés, mint hogy legyen egy visszafejthető.
# ⚠️ Ha lecseréled: a Drive-kapcsolat megszakad (újra kell csatlakoztatni),
#    és a RÉGI mentéseket már csak a mentési jelszóval lehet megnyitni.
#
# ⚠️⚠️ ÁLLÍTS BE MENTÉSI JELSZÓT (Admin → Biztonsági mentés). Ez NEM env
#    változó — a felületen adod meg, és a rendszer csak ellenőrző hasht tárol
#    belőle. AMÍG NINCS BEÁLLÍTVA, a napi (felügyelet nélküli) mentések
#    KIZÁRÓLAG a fenti BACKUP_ENCRYPTION_KEY-jel nyithatók meg: ha az elveszik,
#    az EGÉSZ ARCHÍVUM véglegesen olvashatatlan. A jelszó beállítása létrehoz
#    egy helyreállító kulcspárt, amitől minden ÚJ mentés a jelszóval, a
#    rendszer nélkül is megnyitható:
#        node scripts/kartoteka-mentes-megnyitas.mjs <fajl.kbk>
#
# ⚠️ A PROXY-KIVÉTEL ELŐFELTÉTEL. Az `/api/internal/*` útvonalakat a
#    `lib/supabase/middleware.ts` átengedi (isInternalWorkerRoute). Enélkül a
#    session nélküli cron-kérés /login-ra terelődik, és a napi mentés NÉMÁN
#    egyáltalán nem fut le. Élesben így ellenőrizhető:
#        curl -i -X POST -H 'Authorization: Bearer <BACKUP_WORKER_SECRET>' \
#             https://kartoteka.app/api/internal/backup
#    JSON törzsnek kell jönnie — HTML vagy 307 esetén a kivétel nincs élesben.

# 32 bájt hexben (64 karakter). Generálás: openssl rand -hex 32
BACKUP_ENCRYPTION_KEY=
# A fejlécbe kerülő kulcs-azonosító (jövőbeli rotációhoz). Alap: k2026a
BACKUP_KEY_ID=k2026a
# Az ütemező Bearer-titka. Minimum 32 karakter. openssl rand -base64 48
BACKUP_WORKER_SECRET=
# A cron által hívott végpont. Productionben csak HTTPS.
BACKUP_WORKER_ENDPOINT=https://kartoteka.app/api/internal/backup
# 'prod' vagy 'test'. A fájl fejlécébe kerül, és a VISSZAÁLLÍTÁS megtagadja
# az eltérő címkéjű mentést — tesztfájl így nem kerülhet élesbe. Alap: prod
BACKUP_ENV_LABEL=prod
# Efölött a mentés HANGOS hibával leáll (nem darabol félig). Alap: 50
BACKUP_MAX_FILE_MB=50
# TARTALÉK TÁROLÓ (ha a Google Drive NINCS összekötve): a Supabase Storage
# PRIVÁT vödre és útvonal-előtagja.
# ⚠️ A tároló-választás AUTOMATIKUS: van Drive-kapcsolat → Drive; nincs →
#    Supabase Storage. Az utóbbi UGYANABBAN a felhő-fiókban van, ahol az
#    adatbázis — a felület ezt ki is írja, mert a mentés fő értéke az, hogy
#    MÁSHOL van. Minden napló-sor rögzíti (`backup_log.storage_nev`), melyik
#    tárolóba került a fájl; az olvasás mindig ONNAN történik.
BACKUP_STORAGE_BUCKET=biztonsagi-mentes
BACKUP_STORAGE_PREFIX=mentesek


# ═══════════════════════════════════════════════════════════════════
# BIZTONSÁGI MENTÉS — GOOGLE DRIVE (2. fázis, 2026-08-11)
# ═══════════════════════════════════════════════════════════════════
# A Google Cloud beállítás lépésről lépésre a mentés-felület útmutatójában.
# A LEGFONTOSABB KÉT LÉPÉS, amit nem szabad kihagyni:
#
#  1) A hatókör KIZÁRÓLAG  https://www.googleapis.com/auth/drive.file
#     ⛔ SEMMI `drive`, SEMMI `drive.readonly` — azok „restricted" kategóriájúak,
#        külső biztonsági auditot (CASA) vonnak maguk után, és a fiók MINDEN
#        fájljához hozzáférést adnának. A `drive.file` csak azt látja, amit
#        maga az alkalmazás hozott létre.
#
#  2) Az OAuth-alkalmazást TEDD „In production" állapotba (PUBLISH APP).
#     ⚠️ Egy EXTERNAL, „Testing" állapotú alkalmazás refresh tokenje 7 NAP UTÁN
#        ÉRVÉNYTELENNÉ VÁLIK: a mentés egy hétig működne, aztán NÉMÁN elhalna.
#        A `drive.file` nem érzékeny hatókör, tehát a közzététel NEM indít auditot.
#        (INTERNAL / Workspace alkalmazásnál ez a csapda nem létezik.)
#
# ⚠️ A Google REFRESH TOKEN NEM env változó: az admin felület „Google Drive
#    összekötése" gombja szerzi meg, és TITKOSÍTVA tárolja a backup_settings
#    táblában (a kulcs a BACKUP_ENCRYPTION_KEY-ből HKDF-fel származik).

# A Google Cloud → Credentials oldalról másolt OAuth kliens-azonosító és -titok.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=

# A visszatérési cím. Üresen hagyva a NEXT_PUBLIC_APP_URL-ből képződik:
#   <NEXT_PUBLIC_APP_URL>/api/auth/google-drive/callback
# ⚠️ A Google Cloud „Authorized redirect URIs" listájában BETŰRE ugyanennek
#    kell szerepelnie (a záró perjel is számít), különben redirect_uri_mismatch.
GOOGLE_DRIVE_REDIRECT_URI=

# Ide megy a hibajelző levél. Üresen hagyva a MASTER_ADMIN_EMAIL címre megy.
BACKUP_ALERT_EMAIL=

# ─────────────────────────────────────────────────────────────────────────────
# Gyülekezeti aldomain (2026-08-27) — <slug>.kartoteka.app
# ─────────────────────────────────────────────────────────────────────────────
# Az az alap-domain, amelynek az ALDOMAINJEIT gyülekezeti oldalként szolgáljuk
# ki. Üresen hagyva a NEXT_PUBLIC_APP_URL gazdagépneve (alap: kartoteka.app).
# Csak akkor állítsd, ha az app egy MÁSIK domainen is fut, és nem ott akarod a
# gyülekezeti aldomaineket.
#
# ⚠️ A kód önmagában nem elég: kell a *.<domain> wildcard DNS-rekord és a
#    Railway wildcard egyéni domainje is — a lépések:
#    docs/GYULEKEZETI-ALDOMAIN-BEALLITAS.md
GYULEKEZETI_ALDOMAIN_BAZIS=
