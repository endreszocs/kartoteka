# Kartotéka Desktop — példa környezeti változók
#
# Másold át `.env`-be (vagy `.env.local`-be), és töltsd ki a valós értékekkel.
# A Vite a `VITE_` prefixű változókat inline-olja a frontend buildbe.
#
# Az M1.3-tól a közös `@kartoteka/supabase-client` csomag az `import.meta.env`-ből
# olvassa ezeket. Éles buildben (M5-től) ezek build-idejű konstansokra cserélődnek.

# Supabase (UE-régió, ugyanaz, mint a web-nek)
VITE_SUPABASE_URL=https://bjytiawckbibqmtlezfl.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...  # A publishable (anon) key — CSAK a publikus kulcs ide!

# Később (M1.5 / M2):
# VITE_APP_ENV=development|staging|production
# VITE_UPDATE_MANIFEST_URL=https://updates.kartoteka.ro/stable/latest.json
