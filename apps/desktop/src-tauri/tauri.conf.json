{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kartotéka",
  "version": "0.9.1",
  "identifier": "com.erek.kartoteka",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kartotéka",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "maximized": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: tauri: asset:; font-src 'self' data:; connect-src 'self' ipc: tauri: https://*.supabase.co https://*.up.railway.app; media-src 'self' blob:; frame-src 'none'; object-src 'none'; base-uri 'self'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhFQkFDMkU3N0M3MzJEQ0UKUldUT0xYTjg1OEs2anFvTDFJdnA4WmUwL3NEczVTWE4vQ0FIMUxxWVk2dDdXYXErcXZuMHNBUTkK",
      "endpoints": [
        "https://bjytiawckbibqmtlezfl.supabase.co/storage/v1/object/public/updater/{{target}}-{{arch}}/latest.json"
      ]
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": "all",
    "resources": ["resources/konyveles/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© Barátosi Református Egyházközség / EREK — 2026",
    "publisher": "EREK Kartotéka",
    "shortDescription": "Egyházi adminisztrációs rendszer",
    "longDescription": "A Kartotéka egyházi adminisztrációs rendszer: tagnyilvántartás, pénzügy, anyakönyv és további modulok — egy helyen.",
    "windows": {
      "certificateThumbprint": "F8DE7E854FF9E9DBA9CBD183F79B3F9753A87CE3",
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "languages": ["Hungarian"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "installMode": "currentUser",
        "compression": "lzma",
        "customLanguageFiles": {
          "Hungarian": "installer/Hungarian.nsh"
        }
      },
      "wix": {
        "language": ["hu-HU"]
      }
    }
  }
}
