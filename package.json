{
  "name": "kartoteka",
  "version": "0.1.0",
  "private": true,
  "description": "Kartotéka — EREK egyházi adminisztrációs rendszer (monorepo: web + desktop + közös csomagok)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@kartoteka/web",
    "build": "npm run build --workspace=@kartoteka/web",
    "start": "npm run start --workspace=@kartoteka/web",
    "lint": "npm run lint --workspace=@kartoteka/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint:desktop-imports": "node scripts/check-desktop-banned-imports.mjs",
    "selftest": "npm run selftest:biblia && npm run selftest:enekeskonyv && npm run selftest:print-columns && npm run selftest:kis-naplok && npm run selftest:adatlap && npm run selftest:2fa && npm run selftest:worklog-stats && npm run selftest:reszszamadas && npm run selftest:csoportnaplo && npm run selftest:keszpenz-korlatok && npm run selftest:kuka && npm run selftest:szemely-torles && npm run selftest:backup && npm run selftest:hatokor && npm run selftest:cim-terkep && npm run selftest:attekintes && npm run selftest:ubl-parser && npm run selftest:osszesito",
    "selftest:biblia": "node scripts/selftest-biblia.mjs",
    "selftest:enekeskonyv": "node scripts/selftest-enekeskonyv.mjs",
    "selftest:print-columns": "node scripts/selftest-print-columns.mjs",
    "selftest:kis-naplok": "node scripts/selftest-kis-naplok.mjs",
    "selftest:adatlap": "node scripts/selftest-adatlap.mjs",
    "selftest:2fa": "node scripts/selftest-2fa.mjs",
    "selftest:worklog-stats": "node scripts/selftest-worklog-stats.mjs",
    "selftest:reszszamadas": "node scripts/selftest-reszszamadas.mjs",
    "selftest:csoportnaplo": "node scripts/selftest-csoportnaplo.mjs",
    "selftest:keszpenz-korlatok": "node scripts/selftest-keszpenz-korlatok.mjs",
    "selftest:kuka": "node scripts/selftest-kuka.mjs",
    "selftest:szemely-torles": "node scripts/selftest-szemely-torles.mjs",
    "selftest:backup": "node scripts/selftest-backup.mjs",
    "selftest:cim-terkep": "node scripts/selftest-cim-terkep.mjs",
    "selftest:hatokor": "node scripts/selftest-hatokor.mjs",
    "selftest:attekintes": "node scripts/selftest-attekintes.mjs",
    "selftest:ubl-parser": "node scripts/selftest-ubl-parser.mjs",
    "selftest:osszesito": "node scripts/selftest-osszesito.mjs",
    "audit:safety": "npm run audit:safety --workspace=@kartoteka/web",
    "desktop:dev": "npm run tauri dev --workspace=@kartoteka/desktop",
    "desktop:build": "npm run tauri build --workspace=@kartoteka/desktop",
    "desktop:vite": "npm run dev --workspace=@kartoteka/desktop",
    "adr:seed": "node scripts/build-adr-seed.mjs"
  }
}
